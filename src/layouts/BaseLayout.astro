---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { 
  title = "Finn Hertsch", 
  description = "Finn Hertsch — Research in Representation Geometry, Self-Supervised Vision & Stream Processing.",
  lang = "de"
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (function() {
        var currentLang = document.documentElement.lang;
        var browserLang = navigator.language || navigator.userLanguage || '';
        
        // Skip redirect if the user already explicitly requested English or is already on an English route
        if (currentLang === 'de' && !browserLang.toLowerCase().startsWith('de')) {
          var path = window.location.pathname;
          if (!path.startsWith('/en')) {
            var newPath = '/en' + (path === '/' ? '' : path);
            window.location.replace(newPath);
          }
        }

        // Easter Eggs
        console.log("%c🌑 PITHOS Engine Active", "color: #ececec; background: #111; font-size: 14px; padding: 4px 8px; border-radius: 4px;");
        console.log("%c[SYS] Geometry dictates function. Mechanical sympathy dictates speed.", "font-family: monospace; color: #888;");
        
      })();
    </script>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
    <footer class="legal-footer mono">
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </footer>
  </body>
</html>
