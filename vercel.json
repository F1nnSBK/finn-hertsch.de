{
  "fluid": true,
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": "{vault-encrypted/**,src/content/blog/**,src/data/publication-state.json,src/styles/global.css}"
    }
  },
  "rewrites": [
    {
      "source": "/share/:token",
      "destination": "/api/vault/share?t=:token"
    },
    {
      "source": "/share",
      "destination": "/api/vault/share"
    },
    {
      "source": "/cv",
      "destination": "/index.html"
    },
    {
      "source": "/cv/:ref",
      "destination": "/index.html"
    },
    {
      "source": "/en/cv",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/cv/:ref",
      "destination": "/en/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/essays",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/essays/:slug*",
      "destination": "/blog/:slug*",
      "permanent": true
    },
    {
      "source": "/en/essays",
      "destination": "/en/blog/",
      "permanent": true
    },
    {
      "source": "/en/essays/:slug*",
      "destination": "/en/blog/:slug*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/vault(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/share(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/cv(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/en/cv(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
